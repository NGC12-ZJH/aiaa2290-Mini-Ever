    "epochs": 1,
    "learning_rate": 0.05,
    "batch_size": 128
  },
  "unlearning": {
    "learning_rate": 0.01,
    "batch_size": 64,
    "finetune_epochs": 1,
    "neggrad_epochs": 1,
    "neggrad_alpha": 0.99,
    "scrub_epochs": 1,
