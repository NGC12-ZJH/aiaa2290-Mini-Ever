      "other_uploaders_per_identity": 2,
      "other_uploaders_are_virtual": true
    },
    "forget_pool": "user",
    "forget_units": [
      "account",
      "person"
    ],
    "forget_identities_per_group": 20,
    "forget_group_count": 3,
    "split_seed": 2290,
    "account_seed": 2291,
    "training_seeds": [
      1,
      2,
      3
    ],
    "manifest_path": "data/splits/manifest.json"
  },
  "model": {
    "backbone": "resnet50",
    "initialization": "imagenet_pretrained",
