{
  "status": "calibration_only_not_for_results",
  "project": "aiaa2290-Mini-Ever",
  "data": {
    "dataset": "CelebA",
    "local_root": "data/celeba",
    "image_dir": "img_align_celeba",
    "identity_file": "identity_CelebA.txt",
    "min_images_per_identity": 25,
    "target_identities": 1000,
    "identity_pools": {
      "public": 0.4,
      "user": 0.6
    },
    "split_ratios": {
      "train": 0.7,
      "gallery": 0.1,
      "test": 0.2
    },
    "accounts": {
